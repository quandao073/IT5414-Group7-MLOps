# Copy to .env and fill in the values. Never commit .env. See docs/source/contracts.md (C5).

# Serving: model served by the API
MODEL_PATH=models/model.joblib
MODEL_CARD_PATH=models/model_card.json

# Clients of the API: replay, frontend, load test
API_URL=http://localhost:8000

# Prediction log (contract C9): written by the API, read by the drift service (C14)
# DATABASE_URL=postgresql+psycopg://mlops:mlops@localhost:5432/hotel
REFERENCE_DIR=data/processed
DRIFT_MIN_ROWS=100

# Experiment tracking: shared MLflow server on DagsHub (password = DagsHub access token)
MLFLOW_TRACKING_URI=https://dagshub.com/quandao073/IT5414-Group7-MLOps.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-username>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
